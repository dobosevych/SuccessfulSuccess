# Copy to .env before running `docker compose up`.

# --- database ---------------------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=meetings
POSTGRES_PORT=5432

# --- backend ----------------------------------------------------------------
BACKEND_PORT=8000
APP_TIMEZONE=Europe/Kyiv
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
RUN_MIGRATIONS_ON_START=true
SEED_DEMO_DATA=true

# --- frontend ---------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- aws --------------------------------------------------------------------
# Credentials used by the `aws-*` make targets. Fill these in your own .env
# (gitignored) — never here. AWS_SESSION_TOKEN is only needed for temporary
# credentials (SSO / assumed roles); leave it empty for a plain IAM user key.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=eu-central-1
# Prefix applied to the names of every resource the make targets create.
AWS_RESOURCE_PREFIX=successfulsuccess
# Master password for the RDS instance created by `make aws-deploy`.
# 8-41 characters, letters/digits/underscore/dash only (it is embedded in the
# connection URL). Changing it after the first deploy resets the database user.
AWS_DB_PASSWORD=
# Origins allowed to call the deployed API (the frontend's URL, or * while testing).
AWS_CORS_ORIGINS=*
# Custom domain for the deployed API, e.g. api.example.com. Leave empty to use
# the load balancer's own name over plain HTTP. `make aws-cert` issues the
# certificate for it; `make aws-deploy-backend` then serves HTTPS on it.
AWS_DOMAIN=
